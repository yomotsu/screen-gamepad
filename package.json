{
  "name": "screen-gamepad",
  "version": "0.1.1",
  "author": "Yomotsu",
  "license": "MIT",
  "main": "dist/screen-gamepad.js",
  "jsnext:main": "dist/screen-gamepad.module.js",
  "module": "dist/screen-gamepad.module.js",
  "types": "dist/index.d.ts",
  "repository": "yomotsu/screen-gamepad",
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "downlevel-dts": "^0.11.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "rollup": "^4.64.0",
    "rollup-plugin-typescript2": "^0.37.0",
    "terser": "^5.51.2",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "dev": "rollup --config rollup.config.mjs --watch",
    "build": "rollup --config rollup.config.mjs && terser dist/screen-gamepad.js -o dist/screen-gamepad.min.js --comments '/^!/' && downlevel-dts . .",
    "lint": "eslint src"
  },
  "browserslist": [
    "last 2 versions",
    "ie >= 11"
  ],
  "typesVersions": {
    "<=3.4.0-0": {
      "*": [
        "./"
      ]
    }
  },
  "keywords": []
}
